# Copy to .env.runtime and replace every placeholder with Local-only values.
NODE_ENV=development
BETTER_AUTH_BASE_URL=http://localhost:3000
BETTER_AUTH_BASE_PATH=/api/auth
BETTER_AUTH_SECRET=replace-with-a-random-local-secret-of-at-least-32-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001
DATABASE_RUNTIME_URL=postgresql://gateway_runtime:replace-with-local-runtime-password@127.0.0.1:5432/platform
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true
