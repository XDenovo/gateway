{
  "name": "gateway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "auth:schema:generate": "better-auth generate --config src/auth/cli.ts --output src/db/auth-schema.ts --yes && node scripts/use-auth-schema.mjs && biome check --write src/db/auth-schema.ts",
    "build": "tsc --project tsconfig.json && pnpm client:build",
    "client:build": "pnpm --filter @xdenovo/gateway-client build",
    "client:package:check": "node scripts/check-client-package.mjs",
    "check": "biome check .",
    "check:boundaries": "node scripts/check-runtime-boundaries.mjs",
    "check:fix": "biome check --write .",
    "check:generated": "pnpm auth:schema:generate && pnpm db:generate && git diff --exit-code -- src/db/auth-schema.ts drizzle",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.migration --enable-source-maps --import tsx src/db/migrate.ts",
    "dev": "node --env-file-if-exists=.env.runtime --enable-source-maps --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env.runtime --enable-source-maps dist/index.js",
    "test": "pnpm test:unit && pnpm test:integration",
    "changeset": "changeset",
    "release": "node scripts/check-client-package.mjs --publish",
    "test:coverage": "pnpm client:build && vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:unit": "pnpm client:build && vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "typecheck": "pnpm client:build && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "validate": "pnpm check && pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm build && pnpm client:package:check && pnpm db:check",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@hono/node-server": "2.0.11",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.31",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@better-auth/cli": "1.4.21",
    "@biomejs/biome": "2.5.5",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "@xdenovo/gateway-client": "workspace:*",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "publint": "0.3.22",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
